# Magic Mirror AI - Variables de Entorno
# ---------------------------------------------

# Clave de API de Groq para Whisper (reconocimiento de voz) y LLaMA 3.3 (IA conversacional)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=

# Base de datos PostgreSQL (OPCIONAL: si no la configuras, el sistema usa almacenamiento local resiliente)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/magic_mirror

# Puerto del servidor backend API
PORT=5000
